<?xml version="1.0" encoding="utf-8"?>
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tvName"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginStart="@dimen/vs_10"
    android:layout_marginEnd="@dimen/vs_10"
    android:layout_marginTop="@dimen/vs_5"
    android:layout_marginBottom="@dimen/vs_5"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="@dimen/vs_50"
    android:padding="@dimen/vs_10"
    android:textColor="@color/dialog_text_primary"
    android:textSize="@dimen/ts_22"
    tools:text="请选择首页数据源">

    <!-- 用 selector 内置背景，区分焦点和普通状态 -->
    <android:background>
        <selector>
            <!-- 1. 遥控器焦点选中时的状态：亮蓝色背景 + 白色边框，绝对醒目 -->
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <!-- 亮蓝色，你可以在下面修改为你喜欢的颜色 -->
                    <solid android:color="#FF1976D2" />
                    <corners android:radius="@dimen/vs_5" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
            
            <!-- 2. 默认状态（未选中）：完全不透明的深灰色（#FF 代表 100% 不透明） -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FF1E1E1E" />
                    <corners android:radius="@dimen/vs_5" />
                </shape>
            </item>
        </selector>
    </android:background>

</TextView>
